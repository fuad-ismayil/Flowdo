@using System.Linq
@model IReadOnlyList<Flowdo.Web.Models.TaskItem>

@{
    ViewData["Title"] = "My Tasks";

    var lanes = new[]
    {
        new { Status = "todo", Title = "To Do" },
        new { Status = "in_progress", Title = "In Progress" },
        new { Status = "done", Title = "Done" }
    };
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>My Tasks</h1>
            <p class="text-muted">
                Welcome, @User.Identity?.Name!
            </p>
        </div>

        <a href="/" class="btn btn-outline-secondary">
            Home
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="card mb-4">
        <div class="card-body">

            <h5>Create New Task</h5>

            <form asp-controller="Tasks"
                  asp-action="Create"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label class="form-label">
                        Title
                    </label>

                    <input name="Title"
                           class="form-control"
                           maxlength="160"
                           required />
                </div>

                <div class="mb-3">
                    <label class="form-label">
                        Description
                    </label>

                    <textarea name="Description"
                              class="form-control"
                              maxlength="3000"></textarea>
                </div>

                <button class="btn btn-primary"
                        type="submit">
                    Add Task
                </button>
            </form>
        </div>
    </div>

    <div class="row g-3">

        @foreach (var lane in lanes)
        {
            var items = Model
                .Where(t => t.Status == lane.Status)
                .ToList();

            <div class="col-12 col-lg-4">
                <div class="card h-100">
                    <div class="card-header">
                        <strong>@lane.Title</strong>
                        <span class="text-muted">
                            (@items.Count)
                        </span>
                    </div>

                    <div class="card-body">

                        @if (items.Count == 0)
                        {
                            <p class="text-muted">
                                No tasks here yet.
                            </p>
                        }

                        @foreach (var task in items)
                        {
                            <div class="card mb-3">
                                <div class="card-body">

                                    <h6>@task.Title</h6>

                                    <p class="text-muted small">
                                        @task.Description
                                    </p>

                                    @if (task.Status != "done")
                                    {
                                        <a asp-controller="Tasks"
                                           asp-action="Edit"
                                           asp-route-id="@task.Id"
                                           class="btn btn-sm btn-outline-primary mb-2">
                                            Edit
                                        </a>

                                        <form asp-controller="Tasks"
                                              asp-action="ChangeStatus"
                                              asp-route-id="@task.Id"
                                              method="post"
                                              class="mb-2">

                                            @Html.AntiForgeryToken()

                                            @if (task.Status == "todo")
                                            {
                                                <button type="submit"
                                                        name="nextStatus"
                                                        value="in_progress"
                                                        class="btn btn-sm btn-warning">
                                                    Start
                                                </button>
                                            }

                                            <button type="submit"
                                                    name="nextStatus"
                                                    value="done"
                                                    class="btn btn-sm btn-success">
                                                Complete
                                            </button>
                                        </form>
                                    }

                                    @if (task.Status == "todo" &&
                                         !task.HasStarted)
                                    {
                                        <form asp-controller="Tasks"
                                              asp-action="Delete"
                                              asp-route-id="@task.Id"
                                              method="post">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger"
                                                    onclick="return confirm('Delete this task?')">
                                                Delete
                                            </button>
                                        </form>
                                    }

                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>